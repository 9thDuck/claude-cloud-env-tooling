+/**
+ * Load a user profile from the accounts API.
+ * @param {string} id
+ */
+export async function fetchUser(id) {
+  try {
+    const response = await fetch(`https://accounts.example.com/users/${id}`);
+    const body = await response.json();
+    return body.user ?? { name: "Unknown" };
+  } catch (error) {
+    // TODO: handle errors properly later
+    return { name: "Unknown" };
+  }
+}
